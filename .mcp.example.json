{
    "mcpServers": {
        "unity-api": {
            "command": "uvx",
            "args": [
                "--with",
                "mcp[cli]<2",
                "unity-api-mcp"
            ],
            "env": {
                "UNITY_PROJECT_PATH": "ProjectSettings/ProjectVersion.txt"
            }
        },
        "codegraph": {
            "type": "stdio",
            "command": "codegraph",
            "args": [
                "serve",
                "--mcp"
            ],
            "env": {
                "CODEGRAPH_NO_INSTALL_REFRESH": "1"
            }
        }
    }
}
